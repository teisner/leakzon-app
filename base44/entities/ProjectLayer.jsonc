{
  "name": "ProjectLayer",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the project this layer belongs to"
    },
    "name": {
      "type": "string",
      "description": "Display name of the layer"
    },
    "category": {
      "type": "string",
      "description": "Layer classification (e.g. Water Lines, Valves, Hydrant, Water Tower, Pump Stations, Reservoir Water, Other)"
    },
    "layer_type": {
      "type": "string",
      "enum": [
        "shp",
        "data"
      ],
      "description": "Layer type: shp (shapefile/GeoJSON) or data (tabular data)"
    },
    "file_url": {
      "type": "string",
      "description": "URL of the uploaded file"
    },
    "color": {
      "type": "string",
      "description": "Display color for the layer on the map"
    },
    "icon_url": {
      "type": "string",
      "description": "URL of a custom icon image for point layers (replaces the colored dot)"
    },
    "is_manual": {
      "type": "boolean",
      "default": false,
      "description": "Whether this layer was created manually by placing points on the map"
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether the layer is visible on the map"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in the layers panel (lower = higher in panel and on top of map)"
    },
    "feature_count": {
      "type": "number",
      "default": 0,
      "description": "Number of features in the GeoJSON"
    },
    "geometry_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Unique geometry types found in the data"
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Property/attribute names found in the features"
    },
    "bounds": {
      "type": "object",
      "properties": {
        "north": {
          "type": "number"
        },
        "south": {
          "type": "number"
        },
        "east": {
          "type": "number"
        },
        "west": {
          "type": "number"
        }
      },
      "description": "Geographic bounds of the layer data"
    },
    "altitude_field": {
      "type": "string",
      "description": "Name of the property field containing altitude/elevation data, or 'z' if altitude comes from 3D geometry coordinates"
    },
    "altitude_source": {
      "type": "string",
      "enum": [
        "property",
        "z_coordinate"
      ],
      "description": "Source of altitude data: property (a feature attribute) or z_coordinate (3rd value in geometry coordinates)"
    },
    "altitude_unit": {
      "type": "string",
      "enum": [
        "m",
        "ft"
      ],
      "description": "Unit of altitude data: m (meters) or ft (feet), detected from the field name"
    },
    "pipe_config": {
      "type": "object",
      "description": "Configuration for pipe/water-line layers: per-diameter styling and visibility",
      "properties": {
        "uniform": {
          "type": "boolean",
          "default": false,
          "description": "When true, render all pipes in a single color with uniform width instead of per-diameter styling"
        },
        "show_diameter_labels": {
          "type": "boolean",
          "default": false,
          "description": "When true, display diameter labels at the midpoint of each pipe line on the map"
        },
        "diameter_field": {
          "type": "string",
          "description": "Property field name used for diameter"
        },
        "diameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              },
              "visible": {
                "type": "boolean"
              },
              "count": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "point_config": {
      "type": "object",
      "description": "Styling configuration for point layers: shape, fill style and marker size",
      "properties": {
        "shape": {
          "type": "string",
          "enum": [
            "circle",
            "star",
            "square",
            "triangle"
          ],
          "default": "circle",
          "description": "Marker shape for point features"
        },
        "fill_style": {
          "type": "string",
          "enum": [
            "filled",
            "outline"
          ],
          "description": "Filled shape or outline only"
        },
        "radius": {
          "type": "number",
          "description": "Marker radius in pixels"
        },
        "icon_size": {
          "type": "number",
          "description": "Size in pixels for custom icon markers"
        }
      }
    }
  },
  "required": [
    "project_id",
    "name",
    "layer_type",
    "file_url"
  ]
}