{
  "name": "Dma",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the project this DMA belongs to"
    },
    "name": {
      "type": "string",
      "description": "DMA display name"
    },
    "color": {
      "type": "string",
      "description": "Display color for the DMA polygon"
    },
    "transparency": {
      "type": "number",
      "default": 0.3,
      "description": "Fill transparency (0-1)"
    },
    "polygon": {
      "type": "string",
      "description": "JSON string of [[lat,lng],...] polygon coordinates"
    },
    "meter_count": {
      "type": "number",
      "default": 0,
      "description": "Number of sub-meters (non-main) within this DMA"
    },
    "main_meter_id": {
      "type": "string",
      "description": "ID of the main meter linked to this DMA"
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether the DMA polygon is visible on the map"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "project_id",
    "name",
    "polygon"
  ]
}